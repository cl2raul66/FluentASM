bucleDemoRoto
    .data(dt -> {
        dt.define<Byte:8>(d -> d.id(limite).value(5))
    })
    .execute(ex -> {
        ex.routines(rt -> {
            rt.define(d -> {
                d.id(main)
                d.run(() -> {
                    Gpr0.copy(defaultValue)
                    Gpr1.compare([limite -])
                    Ipr.flowStackJump()
                })
            })
        })
    })
    .initialize()
