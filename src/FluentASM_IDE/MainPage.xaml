<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentASM_IDE.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentASM_IDE.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <!--  Editor (componente independiente) y telemetría.  -->
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ==============================================  -->
        <!--  FILA 0: COMPONENTE DE EDITOR INDEPENDIENTE.     -->
        <!--  ==============================================  -->
        <controls:CodeEditorControl
            x:Name="EditorControl"
            Grid.Row="0"
            ViewModel="{x:Bind ViewModel.Editor, Mode=OneWay}" />

        <!--  ==============================================  -->
        <!--  ROW 1: FLOATING AMBIENT STATUS DOCK (28px)      -->
        <!--  ==============================================  -->
        <controls:StatusDock
            x:Name="StatusDockControl"
            Grid.Row="1"
            FormatRequested="OnStatusDockFormatRequested"
            ViewModel="{x:Bind ViewModel.StatusDock, Mode=OneWay}" />

        <!--  ==============================================  -->
        <!--  COMMAND PALETTE MODAL OVERLAY (Ctrl+P / '/')    -->
        <!--  ==============================================  -->
        <controls:CommandPaletteOverlay
            x:Name="CommandPaletteControl"
            Canvas.ZIndex="50"
            Closed="OnPaletteClosed"
            CommandQuery="{x:Bind ViewModel.CommandPalette.CommandQuery, Mode=TwoWay}"
            IsOpen="{x:Bind ViewModel.CommandPalette.IsOpen, Mode=TwoWay}"
            ItemsSource="{x:Bind ViewModel.CommandPalette.FilteredCommands, Mode=OneWay}"
            ViewModel="{x:Bind ViewModel.CommandPalette, Mode=OneWay}" />
    </Grid>
</Page>
