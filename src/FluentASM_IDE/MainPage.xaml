<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentASM_IDE.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentASM_IDE"
    xmlns:models="using:FluentASM_IDE.Models"
    xmlns:controls="using:FluentASM_IDE.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#131313"
    KeyDown="OnPageKeyDown">

    <Page.Resources>
        <!-- Storyboard for pulsing Ready indicator -->
        <Storyboard x:Name="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusPulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3"
                             Duration="0:0:1.0"
                             AutoReverse="True" />
        </Storyboard>
    </Page.Resources>

    <Grid>
        <!-- Ambient subtle Mica glow accents (from Stitch design) -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Width="600" Height="350" Fill="#0D60CDFF" Canvas.Left="200" Canvas.Top="-100" />
            <Ellipse Width="500" Height="400" Fill="#0881CFFF" Canvas.Left="600" Canvas.Top="200" />
        </Canvas>

        <!-- Main Layout: Editor & Telemetry Dock -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- ROW 0: REAL RICH EDIT BOX & CODE GUTTER       -->
            <!-- ============================================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Gutter Column: 52px width -->
                    <ColumnDefinition Width="52" />
                    <!-- 1px Gutter vertical divider stroke -->
                    <ColumnDefinition Width="1" />
                    <!-- Code Editor Column -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Line Numbers Gutter -->
                <ScrollViewer Grid.Column="0"
                              x:Name="GutterScrollViewer"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <TextBlock Text="{x:Bind ViewModel.LineNumbersText, Mode=OneWay}"
                               FontFamily="{StaticResource CodeFontFamily}"
                               FontSize="13"
                               Foreground="#70889299"
                               TextAlignment="Right"
                               LineHeight="22"
                               LineStackingStrategy="BlockLineHeight"
                               Margin="0,8,16,24" />
                </ScrollViewer>

                <!-- Gutter Divider Stroke -->
                <Rectangle Grid.Column="1"
                           Fill="#14FFFFFF"
                           Width="1"
                           VerticalAlignment="Stretch" />

                <!-- Editor Workspace Column -->
                <Grid Grid.Column="2">
                    <!-- Active Line Highlight Overlay (Tracking current cursor row) -->
                    <Border Height="22"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Background="#262626"
                            Margin="{x:Bind ViewModel.ActiveLineMargin, Mode=OneWay}"
                            IsHitTestVisible="False" />

                    <!-- Real Native WinUI 3 RichEditBox Editor -->
                    <RichEditBox x:Name="EditorBox"
                                 AcceptsReturn="True"
                                 IsSpellCheckEnabled="False"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 Padding="16,8,16,24"
                                 FontFamily="{StaticResource CodeFontFamily}"
                                 FontSize="13"
                                 Foreground="#E5E2E1"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 TextChanged="OnEditorTextChanged"
                                 SelectionChanged="OnEditorSelectionChanged"
                                 KeyDown="OnEditorKeyDown" />

                    <!-- ============================================== -->
                    <!-- CUSTOMIZABLE INTELLISENSE OVERLAY (LSP READY)   -->
                    <!-- ============================================== -->
                    <controls:IntelliSenseOverlay x:Name="IntelliSenseControl"
                                                  VerticalAlignment="Top"
                                                  HorizontalAlignment="Left"
                                                  Margin="200,165,0,0"
                                                  ItemsSource="{x:Bind ViewModel.CompletionItems, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedCompletion, Mode=TwoWay}"
                                                  Visibility="{x:Bind ViewModel.IsIntelliSenseOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  ItemCommitted="OnIntelliSenseItemCommitted"
                                                  Canvas.ZIndex="30" />
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- ROW 1: FLOATING AMBIENT STATUS DOCK (28px)     -->
            <!-- ============================================== -->
            <Border Grid.Row="1"
                    Height="28"
                    Background="#D91B1C1C"
                    BorderBrush="#333E484E"
                    BorderThickness="0,1,0,0"
                    Padding="12,0">
                <Grid>
                    <!-- Left Status Telemetry -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <!-- Pulse Dot + Status Text -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusPulseDot"
                                     Width="6"
                                     Height="6"
                                     Fill="#60CDFF"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#E5E2E1"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Divider -->
                        <Rectangle Width="1" Height="12" Fill="#33889299" VerticalAlignment="Center" />

                        <!-- File Name -->
                        <TextBlock Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   Foreground="#BDC8CF"
                                   VerticalAlignment="Center" />

                        <!-- Divider -->
                        <Rectangle Width="1" Height="12" Fill="#33889299" VerticalAlignment="Center" />

                        <!-- Spacing / Indentation -->
                        <TextBlock Text="{x:Bind ViewModel.IndentInfo, Mode=OneWay}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   Foreground="#BDC8CF"
                                   VerticalAlignment="Center" />

                        <!-- Interactive Command Palette Shortcut Pill -->
                        <Button Padding="6,2"
                                Margin="8,0,0,0"
                                Height="22"
                                Background="#1AFFFFFF"
                                BorderBrush="#263E484E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Command="{x:Bind ViewModel.ToggleCommandPaletteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE756;" FontSize="10" Foreground="#60CDFF" />
                                <TextBlock Text="/ Comandos (Ctrl+P)"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontSize="10"
                                           Foreground="#BDC8CF" />
                            </StackPanel>
                        </Button>

                        <!-- Interactive IntelliSense Toggle Pill -->
                        <Button Padding="6,2"
                                Height="22"
                                Background="#1AFFFFFF"
                                BorderBrush="#263E484E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Command="{x:Bind ViewModel.ToggleIntelliSenseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8EC;" FontSize="10" Foreground="#FFD4BE" />
                                <TextBlock Text="IntelliSense (Ctrl+Espacio)"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontSize="10"
                                           Foreground="#BDC8CF" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Telemetry Coordinates & Architecture -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <!-- Real-time Cursor Ln/Col -->
                        <TextBlock Text="{x:Bind ViewModel.CursorPositionFormatted, Mode=OneWay}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   Foreground="#BDC8CF"
                                   VerticalAlignment="Center" />

                        <Rectangle Width="1" Height="12" Fill="#33889299" VerticalAlignment="Center" />

                        <!-- Encoding -->
                        <TextBlock Text="{x:Bind ViewModel.Encoding, Mode=OneWay}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   Foreground="#E5E2E1"
                                   VerticalAlignment="Center" />

                        <Rectangle Width="1" Height="12" Fill="#33889299" VerticalAlignment="Center" />

                        <!-- Line Ending -->
                        <TextBlock Text="{x:Bind ViewModel.LineEnding, Mode=OneWay}"
                                   FontFamily="{StaticResource CodeFontFamily}"
                                   FontSize="11"
                                   Foreground="#BDC8CF"
                                   VerticalAlignment="Center" />

                        <Rectangle Width="1" Height="12" Fill="#33889299" VerticalAlignment="Center" />

                        <!-- Target Architecture Badge -->
                        <Border Background="#26006687"
                                BorderBrush="#4D60CDFF"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1">
                            <TextBlock Text="{x:Bind ViewModel.Architecture, Mode=OneWay}"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#60CDFF"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- COMMAND PALETTE MODAL OVERLAY (Ctrl+P / '/')   -->
        <!-- ============================================== -->
        <Grid x:Name="CommandPaletteOverlay"
              Background="#66000000"
              Visibility="{x:Bind ViewModel.IsCommandPaletteOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
              PointerPressed="OnBackdropPointerPressed"
              Canvas.ZIndex="50">
            <!-- Centered Top Floating Palette Box -->
            <Border Width="620"
                    MaxHeight="480"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,48,0,0"
                    Background="#F2202020"
                    BorderBrush="#663E484E"
                    BorderThickness="1"
                    CornerRadius="12"
                    PointerPressed="OnPaletteContainerClicked">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <!-- Search / Input Field Box -->
                    <Border Grid.Row="0"
                            Background="#CC262626"
                            BorderBrush="#403E484E"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE756;"
                                      FontSize="16"
                                      Foreground="#60CDFF"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0" />

                            <TextBox Grid.Column="1"
                                     x:Name="CommandInputBox"
                                     Text="{x:Bind ViewModel.CommandQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Escribe un comando con '/' o busca ayuda... (ej. /build, /debug, syscall)"
                                     FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                     FontSize="13.5"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Center"
                                     TextChanged="OnCommandTextChanged"
                                     KeyDown="OnCommandInputKeyDown" />

                            <Border Grid.Column="2"
                                    Background="#353535"
                                    BorderBrush="#553E484E"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    PointerPressed="OnEscBadgeClicked">
                                <TextBlock Text="Esc para salir"
                                           FontFamily="{StaticResource CodeFontFamily}"
                                           FontSize="11"
                                           Foreground="#BDC8CF" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Command Suggestions List -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CommandPaletteItem">
                                    <Border Margin="6,2"
                                            Padding="12,8"
                                            CornerRadius="6"
                                            Background="{x:Bind ItemBackground, Mode=OneWay}"
                                            PointerEntered="OnPaletteItemHover"
                                            PointerExited="OnPaletteItemUnhover"
                                            PointerPressed="OnPaletteItemClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Active indicator bar -->
                                            <Border Grid.Column="0"
                                                    Width="3"
                                                    Height="16"
                                                    CornerRadius="1.5"
                                                    Background="#60CDFF"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ActiveIndicatorVisibility, Mode=OneWay}" />

                                            <!-- Command title + description -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}"
                                                          FontSize="14"
                                                          Foreground="{x:Bind IconBrush}"
                                                          VerticalAlignment="Center" />

                                                <TextBlock Text="{x:Bind Command}"
                                                           FontFamily="{StaticResource CodeFontFamily}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind IconBrush}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Text="{x:Bind Description}"
                                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                           FontSize="12.5"
                                                           Foreground="#BDC8CF"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Shortcut badge (if any) -->
                                            <Border Grid.Column="2"
                                                    Background="#202020"
                                                    BorderBrush="#603E484E"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Shortcut}"
                                                           FontFamily="{StaticResource CodeFontFamily}"
                                                           FontSize="10.5"
                                                           Foreground="#BDC8CF" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- AutoSuggestBox Footer hint -->
                    <Border Grid.Row="2"
                            Background="#E61B1C1C"
                            BorderBrush="#333E484E"
                            BorderThickness="0,1,0,0"
                            Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="#2A2A2A" BorderBrush="#403E484E" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="↑" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" Foreground="#BDC8CF" />
                                    </Border>
                                    <Border Background="#2A2A2A" BorderBrush="#403E484E" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="↓" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" Foreground="#BDC8CF" />
                                    </Border>
                                    <TextBlock Text="navegar" FontSize="11" Foreground="#889299" VerticalAlignment="Center" Margin="2,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border Background="#2A2A2A" BorderBrush="#403E484E" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="↵" FontFamily="{StaticResource CodeFontFamily}" FontSize="10" Foreground="#BDC8CF" />
                                    </Border>
                                    <TextBlock Text="ejecutar" FontSize="11" Foreground="#889299" VerticalAlignment="Center" Margin="2,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="FluentASM Command Runner"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource CodeFontFamily}"
                                       FontSize="11"
                                       Foreground="#B360CDFF" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
