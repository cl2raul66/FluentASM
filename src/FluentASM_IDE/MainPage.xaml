<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentASM_IDE.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FluentASM_IDE.Controls"
    xmlns:converters="using:FluentASM_IDE.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentASM_IDE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentASM_IDE.Models"
    Background="Transparent"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">


    <Grid>
        <!--  Distribución principal: editor y telemetría.  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!--  ==============================================  -->
            <!--  FILA 0: EDITOR RICO Y MARGEN DE CÓDIGO.  -->
            <!--  ==============================================  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!--  Columna del margen: 52 px de ancho.  -->
                    <ColumnDefinition Width="52" />
                    <!--  Columna del editor de código.  -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Margen de números de línea.  -->
                <ScrollViewer
                    x:Name="GutterScrollViewer"
                    Grid.Column="0"
                    HorizontalScrollBarVisibility="Disabled"
                    IsHitTestVisible="False"
                    VerticalScrollBarVisibility="Hidden">
                    <TextBlock
                        Margin="0,8,16,24"
                        FontFamily="{StaticResource CodeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource GutterTextBrush}"
                        LineHeight="22"
                        LineStackingStrategy="BlockLineHeight"
                        Text="{x:Bind ViewModel.LineNumbersText, Mode=OneWay}"
                        TextAlignment="Right" />
                </ScrollViewer>

                <!--  Columna del área de edición.  -->
                <Grid
                    x:Name="EditorHost"
                    Grid.Column="1"
                    SizeChanged="OnEditorHostSizeChanged">
                    <!--  Active Line Highlight Overlay (Tracking current cursor row)  -->
                    <Border
                        Height="22"
                        Margin="{x:Bind ViewModel.ActiveLineMargin, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Background="{ThemeResource EditorActiveLineBrush}"
                        IsHitTestVisible="False" />

                    <!--  Real Native WinUI 3 RichEditBox Editor  -->
                    <RichEditBox
                        x:Name="EditorBox"
                        Padding="16,8,16,24"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        Background="Transparent"
                        BorderThickness="0"
                        ContextRequested="OnEditorContextRequested"
                        CornerRadius="0"
                        FontFamily="{StaticResource CodeFontFamily}"
                        FontSize="16"
                        Foreground="{ThemeResource OnSurfaceBrush}"
                        GotFocus="OnEditorGotFocus"
                        IsSpellCheckEnabled="False"
                        KeyDown="OnEditorKeyDown"
                        PointerEntered="OnEditorPointerEntered"
                        PreviewKeyDown="OnEditorPreviewKeyDown"
                        SelectionChanged="OnEditorSelectionChanged"
                        TextChanged="OnEditorTextChanged" />

                    <!--  ==============================================  -->
                    <!--  CUSTOMIZABLE INTELLISENSE OVERLAY (LSP READY)  -->
                    <!--  ==============================================  -->
                    <controls:IntelliSenseOverlay
                        x:Name="IntelliSenseControl"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Canvas.ZIndex="30"
                        ContextText="{x:Bind ViewModel.CompletionContext, Mode=OneWay}"
                        ItemCommitted="OnIntelliSenseItemCommitted"
                        ItemsSource="{x:Bind ViewModel.CompletionItems, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCompletion, Mode=TwoWay}"
                        SizeChanged="OnIntelliSenseSizeChanged"
                        Visibility="{x:Bind ViewModel.IsIntelliSenseOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>

            <!--  ==============================================  -->
            <!--  ROW 1: FLOATING AMBIENT STATUS DOCK (28px)  -->
            <!--  ==============================================  -->
            <Border
                Grid.Row="1"
                Height="28"
                Padding="12,0"
                Background="{ThemeResource StatusDockBackgroundBrush}"
                BorderBrush="{ThemeResource TitleBarBorderBrush}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Left Status Telemetry  -->
                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!--  Pulse Dot + Status Text  -->
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                x:Name="StatusPulseDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource PrimaryBrush}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CodeFontFamily}"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{ThemeResource OnSurfaceBrush}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Divider  -->
                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  File Name  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                            Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" />

                        <!--  Divider  -->
                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  Contadores reales de errores y advertencias  -->
                        <Button
                            Height="24"
                            Padding="6,2"
                            AutomationProperties.Name="{x:Bind ViewModel.DiagnosticErrorSummary, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.GoToFirstErrorDiagnosticCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DiagnosticErrorSummary, Mode=OneWay}">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{x:Bind ViewModel.DiagnosticErrorBrush, Mode=OneWay}"
                                    Glyph="&#xE783;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="{x:Bind ViewModel.DiagnosticErrorBrush, Mode=OneWay}"
                                    Text="Errores" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.DiagnosticErrorBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.DiagnosticErrorCount, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Height="24"
                            Padding="6,2"
                            AutomationProperties.Name="{x:Bind ViewModel.DiagnosticWarningSummary, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.GoToFirstWarningDiagnosticCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.DiagnosticWarningSummary, Mode=OneWay}">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{x:Bind ViewModel.DiagnosticWarningBrush, Mode=OneWay}"
                                    Glyph="&#xE7BA;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="{x:Bind ViewModel.DiagnosticWarningBrush, Mode=OneWay}"
                                    Text="Advertencias" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind ViewModel.DiagnosticWarningBrush, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.DiagnosticWarningCount, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Right Telemetry Coordinates & Architecture  -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <!--  Format Document (Ctrl+K, Ctrl+D / Shift+Alt+F)  -->
                        <Button
                            Height="24"
                            Padding="6,2"
                            AutomationProperties.Name="Formatear documento o selección"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnFormatButtonClick"
                            ToolTipService.ToolTip="Formatear documento o selección (Ctrl+K, Ctrl+D / Shift+Alt+F)">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{ThemeResource PrimaryBrush}"
                                    Glyph="&#xE8A1;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource OnSurfaceBrush}"
                                    Text="Formatear" />
                            </StackPanel>
                        </Button>

                        <!--  Format On Save (Ctrl+S)  -->
                        <ToggleButton
                            Height="24"
                            Padding="6,2"
                            AutomationProperties.Name="Formatear al guardar"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnFormatOnSaveToggled"
                            IsChecked="{x:Bind ViewModel.FormatOnSave, Mode=TwoWay}"
                            ToolTipService.ToolTip="Formatear el documento al guardar (Ctrl+S)">
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <FontIcon
                                    FontSize="13"
                                    Foreground="{ThemeResource OnSurfaceBrush}"
                                    Glyph="&#xE74E;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource OnSurfaceBrush}"
                                    Text="Al guardar" />
                            </StackPanel>
                        </ToggleButton>

                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  Real-time Cursor Ln/Col  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                            Text="{x:Bind ViewModel.CursorPositionFormatted, Mode=OneWay}" />

                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  Encoding  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource OnSurfaceBrush}"
                            Text="{x:Bind ViewModel.Encoding, Mode=OneWay}" />

                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  Line Ending  -->
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                            Text="{x:Bind ViewModel.LineEnding, Mode=OneWay}" />

                        <Rectangle
                            Width="1"
                            Height="12"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource OutlineVariantBrush}" />

                        <!--  Target Architecture Badge  -->
                        <Border
                            Padding="6,1"
                            Background="{ThemeResource BadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource BadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CodeFontFamily}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PrimaryBrush}"
                                Text="{x:Bind ViewModel.Architecture, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  ==============================================  -->
        <!--  COMMAND PALETTE MODAL OVERLAY (Ctrl+P / '/')  -->
        <!--  ==============================================  -->
        <Grid
            x:Name="CommandPaletteOverlay"
            Background="{ThemeResource PaletteBackdropBrush}"
            Canvas.ZIndex="50"
            PointerPressed="OnBackdropPointerPressed"
            Visibility="{x:Bind ViewModel.IsCommandPaletteOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!--  Centered Top Floating Palette Box  -->
            <Border
                Width="620"
                MaxHeight="480"
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource ModalBackgroundBrush}"
                BorderBrush="{ThemeResource OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="12"
                PointerPressed="OnPaletteContainerClicked">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <!--  Search / Input Field Box  -->
                    <Border
                        Grid.Row="0"
                        Padding="14,10"
                        Background="{ThemeResource ModalHeaderBrush}"
                        BorderBrush="{ThemeResource TitleBarBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource PrimaryBrush}"
                                Glyph="&#xE756;" />

                            <TextBox
                                x:Name="CommandInputBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                FontSize="13.5"
                                KeyDown="OnCommandInputKeyDown"
                                PlaceholderText="Escribe un comando con '/' o busca ayuda... (ej. /problema, /reanalizar, Gpr)"
                                Text="{x:Bind ViewModel.CommandQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextChanged="OnCommandTextChanged" />

                            <Border
                                Grid.Column="2"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SurfaceContainerHighestBrush}"
                                BorderBrush="{ThemeResource OutlineVariantBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                PointerPressed="OnEscBadgeClicked">
                                <TextBlock
                                    FontFamily="{StaticResource CodeFontFamily}"
                                    FontSize="11"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                    Text="Esc para salir" />
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Command Suggestions List  -->
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="360"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="6,2"
                                        Padding="12,8"
                                        Background="{Binding ItemBackground, Mode=OneWay}"
                                        CornerRadius="6"
                                        PointerEntered="OnPaletteItemHover"
                                        PointerExited="OnPaletteItemUnhover"
                                        PointerPressed="OnPaletteItemClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Active indicator bar  -->
                                            <Border
                                                Grid.Column="0"
                                                Width="3"
                                                Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource PrimaryBrush}"
                                                CornerRadius="1.5"
                                                Visibility="{Binding ActiveIndicatorVisibility, Mode=OneWay}" />

                                            <!--  Command title + description  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="10">
                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Foreground="{Binding IconBrush}"
                                                    Glyph="{Binding IconGlyph}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource CodeFontFamily}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding IconBrush}"
                                                    Text="{Binding Command}" />

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                    FontSize="12.5"
                                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                    Text="{Binding Description}" />
                                            </StackPanel>

                                            <!--  Shortcut badge (if any)  -->
                                            <Border
                                                Grid.Column="2"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SurfaceContainerBrush}"
                                                BorderBrush="{ThemeResource OutlineVariantBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontFamily="{StaticResource CodeFontFamily}"
                                                    FontSize="10.5"
                                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                    Text="{Binding Shortcut}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  AutoSuggestBox Footer hint  -->
                    <Border
                        Grid.Row="2"
                        Padding="14,0"
                        Background="{ThemeResource StatusDockBackgroundBrush}"
                        BorderBrush="{ThemeResource TitleBarBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="14">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border
                                        Padding="4,1"
                                        Background="{ThemeResource SurfaceContainerHighBrush}"
                                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="10"
                                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                            Text="↑" />
                                    </Border>
                                    <Border
                                        Padding="4,1"
                                        Background="{ThemeResource SurfaceContainerHighBrush}"
                                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="10"
                                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                            Text="↓" />
                                    </Border>
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource OutlineBrush}"
                                        Text="navegar" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Border
                                        Padding="5,1"
                                        Background="{ThemeResource SurfaceContainerHighBrush}"
                                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontFamily="{StaticResource CodeFontFamily}"
                                            FontSize="10"
                                            Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                            Text="↵" />
                                    </Border>
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource OutlineBrush}"
                                        Text="ejecutar" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CodeFontFamily}"
                                FontSize="11"
                                Foreground="{ThemeResource PrimaryBrush}"
                                Text="Paleta de comandos FluentASM" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
