<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="FluentASM_IDE.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentASM_IDE"
    xmlns:converters="using:FluentASM_IDE.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- FluentASM Stitch Theme Palette -->
            <Color x:Key="SurfaceColor">#131313</Color>
            <Color x:Key="SurfaceContainerLowColor">#1B1C1C</Color>
            <Color x:Key="SurfaceContainerColor">#202020</Color>
            <Color x:Key="SurfaceContainerHighColor">#2A2A2A</Color>
            <Color x:Key="SurfaceContainerHighestColor">#353535</Color>

            <Color x:Key="PrimaryColor">#60CDFF</Color>
            <Color x:Key="PrimaryFixedColor">#B4E4FF</Color>
            <Color x:Key="SecondaryColor">#81CFFF</Color>
            <Color x:Key="TertiaryColor">#FFD4BE</Color>
            <Color x:Key="TertiaryFixedColor">#FFDBC9</Color>
            <Color x:Key="OutlineColor">#889299</Color>
            <Color x:Key="OutlineVariantColor">#3E484E</Color>
            <Color x:Key="OnSurfaceColor">#E5E2E1</Color>
            <Color x:Key="OnSurfaceVariantColor">#BDC8CF</Color>
            <Color x:Key="ErrorColor">#FFB4AB</Color>

            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
            <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
            <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
            <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />

            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="PrimaryFixedBrush" Color="{StaticResource PrimaryFixedColor}" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
            <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
            <SolidColorBrush x:Key="TertiaryFixedBrush" Color="{StaticResource TertiaryFixedColor}" />
            <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />
            <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
            <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

            <FontFamily x:Key="CodeFontFamily">Cascadia Code, Cascadia Mono, Consolas, Courier New</FontFamily>
            <FontFamily x:Key="UIFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
