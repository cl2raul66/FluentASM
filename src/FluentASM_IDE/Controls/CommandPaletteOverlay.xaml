<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentASM_IDE.Controls.CommandPaletteOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  Backdrop modal: cubre toda la superficie del control y cierra la paleta.  -->
    <Grid
        x:Name="PaletteRoot"
        Background="{ThemeResource PaletteBackdropBrush}"
        PointerPressed="OnBackdropPointerPressed"
        Visibility="Collapsed">
        <!--  Centered Top Floating Palette Box  -->
        <Border
            Width="620"
            MaxHeight="480"
            Margin="0,48,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource ModalBackgroundBrush}"
            BorderBrush="{ThemeResource OutlineVariantBrush}"
            BorderThickness="1"
            CornerRadius="12"
            PointerPressed="OnPaletteContainerClicked">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!--  Search / Input Field Box  -->
                <Border
                    Grid.Row="0"
                    Padding="14,10"
                    Background="{ThemeResource ModalHeaderBrush}"
                    BorderBrush="{ThemeResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource PrimaryBrush}"
                            Glyph="&#xE756;" />

                        <TextBox
                            x:Name="CommandInputBox"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                            FontSize="13.5"
                            IsEnabled="True"
                            IsTabStop="True"
                            KeyDown="OnCommandInputKeyDown"
                            PlaceholderText="Escribe un comando con '/' o busca ayuda... (ej. /problema, /reanalizar, Gpr)"
                            Text="{x:Bind CommandQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SurfaceContainerHighestBrush}"
                            BorderBrush="{ThemeResource OutlineVariantBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            PointerPressed="OnEscBadgeClicked">
                            <TextBlock
                                FontFamily="{StaticResource CodeFontFamily}"
                                FontSize="11"
                                Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                Text="Esc para salir" />
                        </Border>
                    </Grid>
                </Border>

                <!--  Command Suggestions List  -->
                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="360"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="6,2"
                                    Padding="12,8"
                                    Background="{Binding ItemBackground, Mode=OneWay}"
                                    CornerRadius="6"
                                    PointerEntered="OnPaletteItemHover"
                                    PointerExited="OnPaletteItemUnhover"
                                    PointerPressed="OnPaletteItemClicked">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Active indicator bar  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="3"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource PrimaryBrush}"
                                            CornerRadius="1.5"
                                            Visibility="{Binding ActiveIndicatorVisibility, Mode=OneWay}" />

                                        <!--  Command title + description  -->
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Foreground="{Binding IconBrush}"
                                                Glyph="{Binding IconGlyph}" />

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding IconBrush}"
                                                Text="{Binding Command}" />

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                FontSize="12.5"
                                                Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                Text="{Binding Description}" />
                                        </StackPanel>

                                        <!--  Shortcut badge (if any)  -->
                                        <Border
                                            Grid.Column="2"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource SurfaceContainerBrush}"
                                            BorderBrush="{ThemeResource OutlineVariantBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                FontSize="10.5"
                                                Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                                Text="{Binding Shortcut}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  AutoSuggestBox Footer hint  -->
                <Border
                    Grid.Row="2"
                    Padding="14,0"
                    Background="{ThemeResource StatusDockBackgroundBrush}"
                    BorderBrush="{ThemeResource TitleBarBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border
                                    Padding="4,1"
                                    Background="{ThemeResource SurfaceContainerHighBrush}"
                                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontFamily="{StaticResource CodeFontFamily}"
                                        FontSize="10"
                                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                        Text="↑" />
                                </Border>
                                <Border
                                    Padding="4,1"
                                    Background="{ThemeResource SurfaceContainerHighBrush}"
                                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontFamily="{StaticResource CodeFontFamily}"
                                        FontSize="10"
                                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                        Text="↓" />
                                </Border>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource OutlineBrush}"
                                    Text="navegar" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border
                                    Padding="5,1"
                                    Background="{ThemeResource SurfaceContainerHighBrush}"
                                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                    <TextBlock
                                        FontFamily="{StaticResource CodeFontFamily}"
                                        FontSize="10"
                                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                        Text="↵" />
                                </Border>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource OutlineBrush}"
                                    Text="ejecutar" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource CodeFontFamily}"
                            FontSize="11"
                            Foreground="{ThemeResource PrimaryBrush}"
                            Text="Paleta de comandos FluentASM" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
