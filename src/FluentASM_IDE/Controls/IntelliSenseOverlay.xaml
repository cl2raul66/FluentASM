<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentASM_IDE.Controls.IntelliSenseOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentASM_IDE.Models"
    mc:Ignorable="d"
    EffectiveViewportChanged="OnOverlayEffectiveViewportChanged">

    <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- Lista contextual de sugerencias. -->
            <Border Width="320"
                    Background="{ThemeResource ModalBackgroundBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Estado contextual/type-state detectado por el LSP. -->
                    <Border Grid.Row="0"
                            Margin="10,8,10,0"
                            Padding="8,4"
                            Background="{ThemeResource SurfaceContainerHighBrush}"
                            BorderBrush="{ThemeResource TitleBarBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{x:Bind ContextVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Contexto"
                                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                       FontSize="10"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind ContextText, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ListView x:Name="CompletionListView"
                              Grid.Row="1"
                              MaxHeight="260"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              IsItemClickEnabled="False"
                              ItemsSource="{x:Bind DisplayedItems, Mode=OneWay}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ItemBackground, Mode=OneWay}"
                                        BorderBrush="{ThemeResource PrimaryBrush}"
                                        BorderThickness="{Binding SelectedBorderThickness, Mode=OneWay}"
                                        Padding="10,6"
                                        PointerEntered="OnItemPointerEntered"
                                        PointerPressed="OnItemPointerPressed">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding IconGlyph}"
                                                      FontSize="13"
                                                      Foreground="{Binding IconBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}"
                                                       FontFamily="Cascadia Code, Consolas"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource OutlineBrush}"
                                                   Margin="21,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Categorías dinámicas: proceden de Metadata.Category. -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource SurfaceContainerHighBrush}"
                            BorderBrush="{ThemeResource TitleBarBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{x:Bind Categories, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="7,3"
                                                Background="{Binding Background, Mode=OneWay}"
                                                BorderBrush="{ThemeResource PrimaryBrush}"
                                                BorderThickness="{Binding BorderThickness, Mode=OneWay}"
                                                CornerRadius="4"
                                                PointerPressed="OnFilterCategoryClicked">
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                                       FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Documentación; permanece oculta mientras no hay selección. -->
            <Border Width="310"
                    Background="{ThemeResource ModalBackgroundBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind DocumentationVisibility, Mode=OneWay}">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind SelectedSignature, Mode=OneWay}"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{x:Bind SelectedDetail, Mode=OneWay}"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="11.5"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               LineHeight="16" />

                    <TextBlock Text="{x:Bind SelectedDocumentation, Mode=OneWay}"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="11"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               LineHeight="15"
                               MaxHeight="150"
                               TextTrimming="CharacterEllipsis" />

                    <Border Height="1" Background="{ThemeResource TitleBarBorderBrush}" Margin="0,2" />

                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Entradas:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedInputs, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Modifica:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedModifies, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Retorna:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedReturns, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Banderas:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedFlags, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
