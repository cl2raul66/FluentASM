<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentASM_IDE.Controls.IntelliSenseOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentASM_IDE.Models"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- ============================================== -->
            <!-- LISTA DE AUTOCOMPLETADO (estilo Fluent) -->
            <!-- ============================================== -->
            <Border Width="280"
                    Background="{ThemeResource ModalBackgroundBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Lista de elementos -->
                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind DisplayedItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ItemBackground, Mode=OneWay}"
                                            BorderBrush="{ThemeResource PrimaryBrush}"
                                            BorderThickness="{Binding SelectedBorderThickness, Mode=OneWay}"
                                            Padding="10,6"
                                            PointerEntered="OnItemPointerEntered"
                                            PointerPressed="OnItemPointerPressed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding IconGlyph}"
                                                          FontSize="13"
                                                          Foreground="{Binding IconBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource OnSurfaceBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}"
                                                       FontFamily="Cascadia Code, Consolas"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource OutlineBrush}"
                                                       Margin="21,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Barra inferior de filtro por categoría -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource SurfaceContainerHighBrush}"
                            BorderBrush="{ThemeResource TitleBarBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Todos -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('All'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="All"
                                        ToolTipService.ToolTip="Todos los símbolos">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                </Border>

                                <!-- Métodos -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Methods'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Methods"
                                        ToolTipService.ToolTip="Métodos fluidos (.copy, .add, .compare)">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="{ThemeResource PrimaryBrush}" />
                                </Border>

                                <!-- Registros -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Registers'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Registers"
                                        ToolTipService.ToolTip="Registros y banderas (GprN, Frf, Ipr)">
                                    <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="{ThemeResource SecondaryBrush}" />
                                </Border>

                                <!-- Etiquetas -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Labels'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Labels"
                                        ToolTipService.ToolTip="Etiquetas locales (@loop, @exit)">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource PrimaryBrush}" />
                                </Border>

                                <!-- Flujo -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Flow'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Flow"
                                        ToolTipService.ToolTip="Instrucciones de flujo (.flowJump, .flowCall)">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="11" Foreground="{ThemeResource TertiaryBrush}" />
                                </Border>
                            </StackPanel>

                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- TARJETA DE DOCUMENTACIÓN A LA DERECHA -->
            <!-- ============================================== -->
            <Border Width="310"
                    Background="{ThemeResource ModalBackgroundBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind SelectedItem.DocCardVisibility, Mode=OneWay}">
                <StackPanel Spacing="6">
                    <!-- Firma -->
                    <TextBlock Text="{x:Bind SelectedItem.Signature, Mode=OneWay}"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Detalle técnico y descripción -->
                    <TextBlock Text="{x:Bind SelectedItem.Detail, Mode=OneWay}"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="11.5"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}"
                               TextWrapping="Wrap"
                               LineHeight="16" />

                    <Border Height="1" Background="{ThemeResource TitleBarBorderBrush}" Margin="0,2" />

                    <!-- Entradas, modificaciones y resultados -->
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Entradas:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedItem.Inputs, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Modifica:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedItem.Modifies, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Retorna:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OutlineBrush}" />
                            <TextBlock Text="{x:Bind SelectedItem.Returns, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="{ThemeResource OnSurfaceBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>














