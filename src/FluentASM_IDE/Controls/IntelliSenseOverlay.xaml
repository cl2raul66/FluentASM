<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentASM_IDE.Controls.IntelliSenseOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentASM_IDE.Models"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
            <!-- ============================================== -->
            <!-- LEFT AUTOCOMPLETE DROPDOWN BOX (Stitch Style)   -->
            <!-- ============================================== -->
            <Border Width="280"
                    Background="#F21B1C1C"
                    BorderBrush="#663E484E"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Items List -->
                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind DisplayedItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CompletionItem">
                                    <Border Background="{x:Bind ItemBackground, Mode=OneWay}"
                                            BorderBrush="#60CDFF"
                                            BorderThickness="{x:Bind SelectedBorderThickness, Mode=OneWay}"
                                            Padding="10,6"
                                            PointerEntered="OnItemPointerEntered"
                                            PointerPressed="OnItemPointerPressed">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind IconGlyph}"
                                                          FontSize="13"
                                                          Foreground="{x:Bind IconBrush}"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind Label}"
                                                           FontFamily="Cascadia Code, Consolas"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#E5E2E1"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Detail}"
                                                       FontFamily="Cascadia Code, Consolas"
                                                       FontSize="10"
                                                       Foreground="#889299"
                                                       Margin="21,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Bottom Category Filter Bar (from Stitch Design) -->
                    <Border Grid.Row="1"
                            Background="#992A2A2A"
                            BorderBrush="#333E484E"
                            BorderThickness="0,1,0,0"
                            Padding="8,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- All -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('All'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="All"
                                        ToolTipService.ToolTip="Todos los símbolos">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="11" Foreground="#BDC8CF" />
                                </Border>

                                <!-- Methods -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Methods'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Methods"
                                        ToolTipService.ToolTip="Métodos fluidos (.copy, .imult, .sub)">
                                    <FontIcon Glyph="&#xE756;" FontSize="11" Foreground="#60CDFF" />
                                </Border>

                                <!-- Registers -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Registers'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Registers"
                                        ToolTipService.ToolTip="Registros y Flags (GprN, rFlags)">
                                    <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#81CFFF" />
                                </Border>

                                <!-- Labels -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Labels'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Labels"
                                        ToolTipService.ToolTip="Etiquetas locales (@loop, @exit)">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#B4E4FF" />
                                </Border>

                                <!-- Flow -->
                                <Border Padding="5,2"
                                        CornerRadius="4"
                                        Background="{x:Bind GetCategoryBg('Flow'), Mode=OneWay}"
                                        PointerPressed="OnFilterCategoryClicked"
                                        Tag="Flow"
                                        ToolTipService.ToolTip="Instrucciones de flujo (.flowJump, .flowCall)">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="11" Foreground="#FFD4BE" />
                                </Border>
                            </StackPanel>

                            <!-- Snippets toggle badge -->
                            <Border HorizontalAlignment="Right"
                                    Background="#3360CDFF"
                                    BorderBrush="#60CDFF"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    ToolTipService.ToolTip="Fragmentos de código rápidos (Alt+T)">
                                <FontIcon Glyph="&#xE71D;" FontSize="10" Foreground="#60CDFF" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- RIGHT DOCUMENTATION CARD (LSP Hover Flyout)     -->
            <!-- ============================================== -->
            <Border Width="310"
                    Background="#F21B1C1C"
                    BorderBrush="#663E484E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind SelectedItem.DocCardVisibility, Mode=OneWay}">
                <StackPanel Spacing="6">
                    <!-- Signature -->
                    <TextBlock Text="{x:Bind SelectedItem.Signature, Mode=OneWay}"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#60CDFF"
                               TextWrapping="Wrap" />

                    <Border Height="1" Background="#263E484E" Margin="0,2" />

                    <!-- Inputs & Modifies & Returns -->
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Inputs:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#889299" />
                            <TextBlock Text="{x:Bind SelectedItem.Inputs, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#E5E2E1"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Modifica:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#889299" />
                            <TextBlock Text="{x:Bind SelectedItem.Modifies, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#E5E2E1"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Retorna:"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#889299" />
                            <TextBlock Text="{x:Bind SelectedItem.Returns, Mode=OneWay}"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="11"
                                       Foreground="#E5E2E1"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
