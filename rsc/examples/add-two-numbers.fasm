; ---------------------------------------------------------------------------
;  add-two-numbers.fasm  -  El ejemplo que cierra la Fase 1
;
;  Fase: 1 (API de C#) y 2 (este archivo).
;  ABI: Win64 -> el parámetro 1 llega en RCX y el 2 en RDX.
;
;  Bytes de la rutina 'AddTwoNumbers' (verificados con NASM, ver docs/ABI.md):
;     prólogo  55 48 89 e5 48 83 ec 20     push rbp / mov rbp,rsp / sub rsp,32
;     cuerpo   48 89 c8 48 01 d0            mov rax,rcx / add rax,rdx
;     epílogo  c9 c3                        leave / ret
;
;  Bytes de la llamada desde 'main' (el desplazamiento de 'call' depende del layout):
;     55 48 89 e5 48 83 ec 20              prólogo de main (llama: reserva sombra)
;     b9 0a 00 00 00                       mov rcx, 10
;     ba 20 00 00 00                       mov rdx, 32
;     e8 rel32                             call AddTwoNumbers
;     c9 c3                                leave / ret
;
;  Comprobación: AddTwoNumbers(10, 32) devuelve 42, y el mismo binario funciona
;  cargado en dos direcciones de memoria distintas (independencia de posición).
; ---------------------------------------------------------------------------

program AddTwoNumbers

    section .text
    entry main

    routine AddTwoNumbers
        parameter a, b          ; Win64: a -> Rcx, b -> Rdx

        .Mov(Rax, a)
        .Add(Rax, b)
        .Ret()
    end

    routine main
        .Mov(Rcx, 10)
        .Mov(Rdx, 32)
        .Call(AddTwoNumbers)    ; devuelve 42 en RAX
        .Ret()
    end

end
